{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "ES2022.Array", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@openwdl/ui": ["../packages/ui/src/index.ts"],
      "@openwdl/ui/*": ["../packages/ui/src/*"]
    }
  },
  "include": ["src", "../packages/ui/src"],
  "exclude": ["../packages/ui/src/**/*.test.ts", "../packages/ui/src/**/*.test.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
